# ==========================================
# Variables de entorno - Dream Journey
# ==========================================
# Copia este archivo a `.env.local` (ignorado por git).
# Reinicia `npm run dev` tras modificarlo.

# 1. Clave secreta de Google Gemini API (Google AI Studio).
# IMPORTANTE: Se configura SIN prefijo VITE_ para protegerla en el servidor.
# Es consumida por la Serverless Function `/api/analyze` tanto en Vercel como en el dev server de Vite.
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# 2. Opcional: Modelo de Google Gemini (por defecto: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Opcional: Solo si el backend / Serverless Functions residen en un dominio diferente.
# Si se deja vacío, la app usa la ruta relativa local/producción: `/api/analyze`.
VITE_API_URL=
